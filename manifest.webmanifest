{
  "name": "The Blueprint Workout App",
  "short_name": "Blueprint",
  "description": "Offline workout logging, progression, muscle-volume tracking, calendars, and session-time history.",
  "id": "blueprint-workout-app",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#071017",
  "theme_color": "#0c1720",
  "icons": [
    {"src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable"},
    {"src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable"}
  ],
  "shortcuts": [
    {"name": "Start workout", "short_name": "Workout", "url": "./index.html#today", "icons": [{"src":"icons/icon-192.png","sizes":"192x192"}]},
    {"name": "Gym calendar", "short_name": "Calendar", "url": "./index.html#calendar", "icons": [{"src":"icons/icon-192.png","sizes":"192x192"}]}
  ]
}
